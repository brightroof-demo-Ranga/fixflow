generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model StaffUser {
  id                    String       @id
  name                  String
  email                 String       @unique
  passwordHash          String
  role                  String
  sessions              Session[]
  technicianAssignments Assignment[] @relation("AssignmentTechnician")
  dispatchedAssignments Assignment[] @relation("AssignmentDispatcher")
}

model Session {
  id          String    @id
  tokenHash   String    @unique
  staffUserId String
  expiresAt   DateTime
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
}

model Customer {
  id       String           @id
  phone    String           @unique
  name     String?
  email    String?
  requests ServiceRequest[]
}

model System {
  id       String           @id
  systemId String           @unique
  requests ServiceRequest[]
}

model ServiceRequest {
  id                         String    @id
  customerId                 String
  systemId                   String
  description                String
  source                     String
  critical                   Boolean   @default(false)
  status                     String
  createdAt                  DateTime
  originalContactAt          DateTime?
  trackingTokenHash          String    @unique
  onSiteAt                   DateTime?
  remoteDiagnosisCompletedAt DateTime?
  completedAt                DateTime?
  cancelledAt                DateTime?
  createTimestampResult      String?
  originalContactResult      String?
  customer                   Customer     @relation(fields: [customerId], references: [id])
  system                     System       @relation(fields: [systemId], references: [systemId])
  assignments                Assignment[]
}

model Assignment {
  id                String         @id
  requestId         String
  technicianId      String
  assignedById      String
  assignedAt        DateTime
  expectedArrivalAt DateTime?
  supersededAt      DateTime?
  request           ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  technician        StaffUser      @relation("AssignmentTechnician", fields: [technicianId], references: [id])
  assignedBy        StaffUser      @relation("AssignmentDispatcher", fields: [assignedById], references: [id])
}
